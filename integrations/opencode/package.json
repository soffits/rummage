{
  "name": "@soffits/opencode-rummage",
  "version": "0.3.0",
  "description": "OpenCode plugin for rummage: recall from your own files on each prompt, a skill for searching them, and indexing progress in the footer.",
  "license": "AGPL-3.0-or-later",
  "author": "Sakina",
  "homepage": "https://github.com/soffits/rummage/blob/main/docs/integrations.md#opencode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/rummage.git",
    "directory": "integrations/opencode"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "memory",
    "recall",
    "search"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./tui": "./tui.js"
  },
  "files": [
    "index.js",
    "tui.js",
    "skills"
  ],
  "scripts": {
    "prepack": "node -e \"require('fs').cpSync('../../skills/rummage', 'skills/rummage', { recursive: true })\""
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
